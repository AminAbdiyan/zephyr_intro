{
    "configurations": [
        {
            "name": "Debug ESP32-S3",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:elfPath}",
            "args": [],
            "stopAtEntry": true,
            "cwd":  "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/opt/toolchains/zephyr-sdk-0.16.8/xtensa-espressif_esp32s3_zephyr-elf/bin/xtensa-espressif_esp32s3_zephyr-elf-gdb",
            "miDebuggerServerAddress": "host.docker.internal:3333",
            "setupCommands": [
                {
                    "description": "Pretty print for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug MCXN236",
            "type": "cppdbg",
            "request": "launch",
            "program": "${input:elfPath}",
            "args": [],
            "stopAtEntry": true,
            "cwd":  "${workspaceFolder}",
            "svdFile": "${workspaceRoot}/.vscode/MCXN236.xml",
            "MIMode": "gdb",
            "miDebuggerPath": "/opt/toolchains/zephyr-sdk-0.16.8/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
            "miDebuggerServerAddress": "host.docker.internal:3333",
            "setupCommands": [
                {
                    "description": "Pretty print for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ], // execute pyocd erase --chip -t mcxn236 and pyocd gdbserver -t mcxn236 --persist --allow-remote in the terminal before starting this debug session
            "postRemoteConnectCommands": [
                {
                    "description": "Halt the target",
                    "text": "monitor erase",
                    "ignoreFailures": true
                },
                {
                    "description": "Periphral read",
                    "text": "set mem inaccessible-by-default off",
                    "ignoreFailures": true
                },
                {
                    "description": "Halt the target",
                    "text": "monitor reset halt",
                    "ignoreFailures": true
                },
                {
                    "description": "Flash firmware onto target",
                    "text": "load",
                    "ignoreFailures": false
                },
                {
                    "description": "Reset target after flash",
                    "text": "monitor reset",
                    "ignoreFailures": true
                },
                
            ]
        }
    ],
    "inputs": [
        {
            "id": "elfPath",
            "type": "promptString",
            "description": "Enter the path to the ELF file",
        }
    ]
}